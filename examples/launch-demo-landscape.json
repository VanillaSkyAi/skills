{
  "format": "launch",
  "orientation": "landscape",
  "style": { "font": "Inter", "defaultTransition": "cut" },
  "audio": { "trackId": "commercial-drive" },
  "scenes": [
    {
      "id": "s0",
      "templateId": "media",
      "backgroundEffect": "slow-zoom-in",
      "variables": {
        "texts": "Launch videos from your terminal",
        "mediaType": "gradient"
      },
      "timing": { "fixedDuration": 2.5 }
    },
    {
      "id": "s1",
      "templateId": "terminal",
      "variables": {
        "texts": "Same command. Any orientation.",
        "command": "vanillasky studio launch.json",
        "output": "✓ config valid — 5 scenes,✓ Studio ready in Chrome,✓ Export MP4 when it feels right",
        "promptPrefix": "$"
      },
      "timing": { "fixedDuration": 3 }
    },
    {
      "id": "s2",
      "templateId": "cardList",
      "variables": {
        "texts": "Made for the wide feeds",
        "items": "Landscape 16:9 for X and LinkedIn posts,Portrait 9:16 for Reels and TikTok,One config field switches between them",
        "itemEmojis": "🖥️,📱,🔁"
      },
      "timing": { "fixedDuration": 3.5 }
    },
    {
      "id": "s3",
      "templateId": "tweet",
      "variables": {
        "authorName": "VanillaSky",
        "authorHandle": "vanillasky_ai",
        "authorVerified": true,
        "message": "Wrote a JSON file, opened Studio, and shaped the video live. No upload, no render farm. 🎬",
        "likes": 214,
        "replies": 12,
        "mediaType": "gradient"
      },
      "timing": { "fixedDuration": 3 }
    },
    {
      "id": "s4",
      "templateId": "ctaLogo",
      "variables": {
        "brandName": "VanillaSky",
        "url": "vanillasky.ai"
      },
      "timing": { "fixedDuration": 3 }
    }
  ]
}
